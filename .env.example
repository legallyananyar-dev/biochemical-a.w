# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_APP=app.py

# Server
HOST=0.0.0.0
PORT=5000

# Biochemical Audio Watermarking (BAW) Settings
SEQUENCE_LENGTH=50
DEFAULT_MOLECULE=H2O
PLACEHOLDER_INTEGRITY_SCORE=0.95

# Audio Processing
AUDIO_SAMPLE_RATE=16000
WATERMARK_AMPLITUDE=0.02
CARRIER_BASE_HZ=18000
CARRIER_SPACING_HZ=500

# Temporary Files
TEMP_DIR=/tmp
