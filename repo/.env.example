# All optional. Set in Vercel: Project Settings > Environment Variables.
SEQUENCE_LENGTH=50          # time steps per signature
SECURITY_THRESHOLD=0.75     # score at or above this counts as "intact"
WATERMARK_AMPLITUDE=0.02    # carrier level relative to the recording's peak
CARRIER_BASE_HZ=18000
CARRIER_SPACING_HZ=500
MAX_UPLOAD_MB=4             # Vercel rejects request bodies over 4.5 MB
